#!/usr/bin/env bash
# start - everyday MeccanicOS tasks. Run from anywhere inside the repo.
#
#   ./start update              newer NixOS packages: refresh flake.lock, rebuild the ISO
#   ./start iso                 build the ISO from flake.lock; copied to
#                               dist/<name>-<release>-…-git<commit>-sha<hash>.iso
#                               (older ones there are removed: dist/ keeps only
#                               the newest)
#   ./start release [NAME]      tag main's head as a release (default: today's
#                               date, v2026-10-16, then v2026-10-16.2, ...) and
#                               push the tag: GitHub builds the ISO and moves
#                               "latest" to it, which installed systems follow
#   ./start vm [OPTIONS]        boot the ISO in QEMU, e.g. vm --cpus 4 --mem 8G
#                               (all options: ./start vm --help)
#   ./start tutorial-video      film the tutorial in a VM (KVM, internet; ~15 min)
#                               -> tutorial/tutorial.mp4, shipped on the next ISO
#   ./start burn /dev/sdX       write the ISO to a USB stick (erases it; asks first)
#   ./start burn                list the USB disks it can see
#   ./start ventoy /dev/sdX     copy the ISO onto a Ventoy stick (deletes nothing
#                               on it); not a Ventoy stick yet: install
#                               Ventoy first (erases it; asks first); an older
#                               Ventoy on it: offers to update it (files stay)
#   ./start ventoy              list the USB disks, marking Ventoy sticks
#   ./start drivers-check       hardware support vs EndeavourOS's live ISO
#                               (modules/drivers/): --upstream compares with
#                               its newest list, --update moves the snapshot

set -euo pipefail
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

nixpkgs_rev() {
    nix eval --raw --impure --expr \
        '(builtins.fromJSON (builtins.readFile ./flake.lock)).nodes.nixpkgs.locked.rev' | cut -c1-12
}

# Today's date goes into the ISO (file name, /etc/os-release) and, with the
# time, into /etc/meccanicos/version; see flake.nix.
now=$(date -u +%Y%m%d%H%M)
export MECCANICOS_BUILD_DATE=${MECCANICOS_BUILD_DATE:-${now:0:8}}
export MECCANICOS_BUILD_TIME=${MECCANICOS_BUILD_TIME:-${now:8:4}}
# ...and which release: the v* tag on this commit when nothing is changed, else
# the branch (main), made fit for /etc/os-release.
release_name() {
    local tag
    if [[ -z $(git status --porcelain) ]] && tag=$(git tag --points-at HEAD --list 'v*' | sort -V | tail -n1) && [[ -n $tag ]]; then
        echo "$tag"
    else
        git rev-parse --abbrev-ref HEAD | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._\n-' '-'
    fi
}
MECCANICOS_RELEASE=${MECCANICOS_RELEASE:-$(release_name)}
export MECCANICOS_RELEASE

# Build, then copy the ISO to dist/ with the first 8 hex digits of its own
# SHA-256 in the name:
#   meccanicos-v2026-10-16-26.05-x86_64-linux-git5b31f5e-sha1a2b3c4d.iso
build_iso() {
    local attr=$1 start out src hash dest
    start=$(date +%s)
    # No ./result link: in a synced folder (Dropbox) a link made on two
    # computers turns into "result (… conflicted copy …)". dist/ has the ISO.
    out=$(nix build ".#$attr" -L --impure --no-link --print-out-paths)
    echo "[iso] built in $((($(date +%s) - start) / 60)) min"
    src=$(echo "$out"/iso/*.iso)
    echo "[iso] hashing $src"
    hash=$(sha256sum "$src" | cut -c1-8)
    dest="dist/$(basename "$src" .iso)-sha$hash.iso"
    mkdir -p dist
    if [[ ! -e $dest ]]; then
        cp --reflink=auto "$src" "$dest.tmp"
        chmod 644 "$dest.tmp"
        mv "$dest.tmp" "$dest"
    else
        touch "$dest" # newest again, for burn
    fi
    # dist/ keeps only the newest ISO.
    local old
    for old in dist/*.iso; do
        [[ $old == "$dest" ]] || { echo "[iso] removing the older $old"; rm -f -- "$old"; }
    done
    ls -lh "$dest"
}

newest_iso() {
    # shellcheck disable=SC2012 # by date; our ISO names have no spaces or newlines
    ls -t dist/*.iso 2>/dev/null | head -n1
}

# Move nixpkgs to the newest commit of the release branch pinned in flake.nix
# (nixos-26.05: security and bug fixes, no version jumps), then rebuild.
update() {
    local before after
    before=$(nixpkgs_rev)
    nix flake update nixpkgs
    after=$(nixpkgs_rev)
    if [[ $before == "$after" ]]; then
        echo "[update] nixpkgs is already the newest ($after); building anyway"
    else
        echo "[update] nixpkgs $before -> $after"
    fi
    build_iso iso
    [[ $before == "$after" ]] || echo "[update] keep it: git commit flake.lock -m 'Update nixpkgs'"
}

iso() {
    [[ $# -eq 0 ]] || { echo "usage: $0 iso" >&2; exit 2; }
    build_iso iso
}

vm() {
    exec nix run .#vm --impure -- "$@"
}

tutorial_video() {
    nix run .#tutorial-video --impure -- "$@"
    git add tutorial/tutorial.mp4  # the flake only sees files git tracks
}

usb_disks() {
    lsblk -d -o NAME,SIZE,TRAN,RM,MODEL | awk 'NR == 1 || $3 == "usb" || $4 == "1"'
}

# The newest ISO in dist/, building one first if there is none.
iso_or_build() {
    local iso
    iso=$(newest_iso)
    if [[ -z $iso ]]; then
        echo "[$1] no ISO in dist/ yet; building it first" >&2
        build_iso iso >&2
        iso=$(newest_iso)
    fi
    echo "$iso"
}

# Refuses anything that isn't a whole USB/removable disk, or holds the system.
check_stick() {
    local tag=$1 dev=$2
    [[ -b $dev ]] || { echo "[$tag] $dev is not a block device" >&2; exit 1; }
    [[ $(lsblk -dno TYPE "$dev") == disk ]] ||
        { echo "[$tag] $dev is a partition; give the whole disk (e.g. /dev/sdb)" >&2; exit 1; }
    if [[ $(lsblk -dno TRAN "$dev") != usb && $(lsblk -dno RM "$dev") != 1 ]]; then
        echo "[$tag] $dev is not a USB or removable disk - refusing" >&2
        exit 1
    fi
    if lsblk -nro MOUNTPOINT "$dev" | grep -qxE '/|/boot|/home|/nix|/nix/store'; then
        echo "[$tag] $dev holds the running system - refusing" >&2
        exit 1
    fi
}

# A big red box naming the stick as "USB DRIVE (/dev/sdX)"; goes on only if
# the user types YES (any case), else exits. $1: tag, $2: device, $3: what
# comes next (e.g. "MeccanicOS is then written on it.").
confirm_erase() {
    local tag=$1 dev=$2 what=$3 name details l w=0 answer
    name="USB DRIVE ($dev)"
    details="$name: $(lsblk -dno MODEL "$dev" | xargs), $(lsblk -dno SIZE "$dev" | xargs)B"
    local lines=(
        "WARNING: EVERYTHING ON THIS USB DRIVE WILL BE ERASED"
        ""
        "$details"
        "All the files on it will be lost. This cannot be undone."
        "$what"
        ""
        "Type YES and press Enter to erase it. Anything else cancels."
    )
    for l in "${lines[@]}"; do ((${#l} > w)) && w=${#l}; done
    printf '\n\033[1;31m╔%s╗\n' "$(printf '═%.0s' $(seq $((w + 4))))"
    for l in "${lines[@]}"; do printf '║  %s%*s  ║\n' "$l" $((w - ${#l})) ""; done
    printf '╚%s╝\033[0m\n\n' "$(printf '═%.0s' $(seq $((w + 4))))"
    read -r -p "Erase $name? Type YES: " answer
    [[ ${answer,,} == yes ]] || { echo "[$tag] cancelled: nothing was written to $name"; exit 1; }
}

# Unmounts every partition of $1; exits if one stays mounted (writing to the
# disk then would damage it, or be lost).
unmount_all() {
    local part mp
    while read -r part mp; do
        [[ -n $mp ]] || continue
        sudo umount "$part" ||
            { echo "[usb] could not unmount $part ($mp): close what uses it and run again; nothing was written" >&2; exit 1; }
    done < <(lsblk -nrpo NAME,MOUNTPOINT "$1")
    if lsblk -nro MOUNTPOINT "$1" | grep -q .; then
        echo "[usb] $1 is still mounted; nothing was written" >&2
        exit 1
    fi
}

# What tells this drive from another one given the same /dev name after an
# unplug: serial number, size, model. A drive with no serial number is told
# apart by size and model only.
disk_identity() { lsblk -bdno SERIAL,SIZE,MODEL "$1" 2>/dev/null | xargs; }

# Exits unless $2 (the device, $1 the tag) is still the drive whose
# disk_identity was $3 when the user said YES.
same_disk() {
    local tag=$1 dev=$2 id=$3
    [[ -n $id && $(disk_identity "$dev") == "$id" ]] ||
        { echo "[$tag] $dev is not the drive you said YES to any more (unplugged or swapped); nothing was written" >&2; exit 1; }
}

# Raw image ("DD mode"), which the encrypted storage on the stick needs.
# Refuses anything that isn't a whole USB/removable disk, and asks first.
burn() {
    local dev=${1:-} iso isosize devsize id
    if [[ -z $dev ]]; then
        echo "usage: $0 burn /dev/sdX"
        echo
        echo "USB / removable disks:"
        usb_disks
        exit 2
    fi
    iso=$(iso_or_build burn)
    check_stick burn "$dev"
    isosize=$(stat -Lc %s "$iso")
    devsize=$(lsblk -bdno SIZE "$dev")
    ((devsize >= isosize)) || { echo "[burn] $dev is smaller than the ISO" >&2; exit 1; }

    echo "ISO:    $iso ($((isosize / 1000000)) MB)"
    echo "Target: USB DRIVE ($dev)"
    lsblk -o NAME,SIZE,TRAN,MODEL,LABEL,MOUNTPOINT "$dev"
    id=$(disk_identity "$dev")
    confirm_erase burn "$dev" "MeccanicOS is then written on it."

    unmount_all "$dev"
    same_disk burn "$dev" "$id"
    sudo dd if="$iso" of="$dev" bs=4M status=progress oflag=sync conv=fsync
    sync
    echo "[burn] done - you can unplug $dev"
}

# A Ventoy stick has Ventoy's EFI partition, labelled VTOYEFI.
is_ventoy() { lsblk -nro LABEL "$1" 2>/dev/null | grep -qx VTOYEFI; }

# Ventoy from the pinned nixpkgs. nixpkgs marks it unfree and insecure
# (prebuilt binaries), so it is allowed here, for this command only.
ventoy_bin() {
    nix build --no-link --print-out-paths --impure --expr '
      let
        flake = builtins.getFlake (toString ./.);
        pkgs = import flake.inputs.nixpkgs {
          system = "x86_64-linux";
          config = {
            allowUnfree = true;
            allowInsecurePredicate = p: (p.pname or "") == "ventoy";
          };
        };
      in pkgs.ventoy' | tail -n1
}

# An older Ventoy can fail to start MeccanicOS on some computers (it stopped
# in Ventoy's own shell on an HP ProDesk 600 G3): offer to update the stick's
# Ventoy to the pinned one. Updating rewrites only Ventoy's own partition and
# boot code; the files on the stick stay. A version it can't tell is left alone.
ventoy_update() {
    local dev=$1 v have want answer id
    v=$(ventoy_bin)
    want=$(< "$v/share/ventoy/ventoy/version")
    have=$(sudo "$v/bin/ventoy" -l "$dev" 2>/dev/null | sed -n 's/^Ventoy Version in Disk: *//p') || true
    [[ -n $have && $have != "$want" ]] || return 0
    [[ $(printf '%s\n' "$have" "$want" | sort -V | head -n1) == "$have" ]] || return 0
    echo "[ventoy] the stick has Ventoy $have; the pinned one is $want."
    echo "         An older Ventoy can fail to start MeccanicOS on some computers."
    id=$(disk_identity "$dev")
    read -r -p "Update Ventoy on USB DRIVE ($dev)? The files on it stay. [Y/n] " answer
    [[ -z $answer || ${answer,,} == y || ${answer,,} == yes ]] || { echo "[ventoy] keeping Ventoy $have"; return 0; }
    unmount_all "$dev"
    same_disk ventoy "$dev" "$id"
    # Ventoy asks once more; we already have the yes.
    if ! { yes y || true; } | sudo "$v/bin/ventoy" -u "$dev"; then
        echo "[ventoy] updating Ventoy failed; the files on the stick are still there" >&2
        exit 1
    fi
    sudo udevadm settle 2>/dev/null || true
    sudo partprobe "$dev" 2>/dev/null || true
    sleep 2
    is_ventoy "$dev" || { echo "[ventoy] Ventoy's partition did not come back on $dev after the update" >&2; exit 1; }
}

# Put the ISO on a Ventoy stick; make it one first if needed (erases it).
ventoy() {
    local dev=${1:-} iso name part mnt v need have id
    if [[ -z $dev ]]; then
        echo "usage: $0 ventoy /dev/sdX"
        echo
        echo "USB / removable disks:"
        usb_disks
        for v in $(lsblk -dnro NAME,TRAN,RM | awk '$2 == "usb" || $3 == "1" {print $1}'); do
            if is_ventoy "/dev/$v"; then echo "  /dev/$v is a Ventoy stick"; fi
        done
        exit 2
    fi
    iso=$(iso_or_build ventoy)
    name=$(basename "$iso")
    check_stick ventoy "$dev"

    if ! is_ventoy "$dev"; then
        echo "USB DRIVE ($dev) is not a Ventoy stick yet:"
        lsblk -o NAME,SIZE,TRAN,MODEL,LABEL,MOUNTPOINT "$dev"
        id=$(disk_identity "$dev")
        confirm_erase ventoy "$dev" "Ventoy is then installed on it, and MeccanicOS copied to it."
        echo "[ventoy] getting Ventoy (from the pinned nixpkgs)"
        v=$(ventoy_bin)
        unmount_all "$dev"
        same_disk ventoy "$dev" "$id"
        # Ventoy asks twice more; we already have the YES.
        { yes y || true; } | sudo "$v/bin/ventoy" -i "$dev"
        sudo udevadm settle 2>/dev/null || true
        sudo partprobe "$dev" 2>/dev/null || true
        sleep 2
        is_ventoy "$dev" || { echo "[ventoy] Ventoy did not install on $dev" >&2; exit 1; }
    else
        ventoy_update "$dev"
    fi

    # Partition 1 is Ventoy's data partition (exFAT by default): ISOs go there.
    # Mounted like the desktop does (udisks, no sudo) when possible; files
    # then belong to you, so plain cp/rm work. Otherwise sudo mount.
    part=$(lsblk -nrpo NAME,TYPE "$dev" | awk '$2 == "part" {print $1; exit}')
    local as=sudo
    mnt=$(lsblk -nro MOUNTPOINTS "$part" | head -n1)
    if [[ -n $mnt && -w $mnt ]]; then
        as=""
    elif command -v udisksctl >/dev/null && udisksctl mount -b "$part" >/dev/null 2>&1; then
        mnt=$(lsblk -nro MOUNTPOINTS "$part" | head -n1)
        as=""
        # Values filled in now: the trap runs after this function's locals are gone.
        # shellcheck disable=SC2064
        trap "sync; udisksctl unmount -b $(printf %q "$part") >/dev/null 2>&1 || true" EXIT
    else
        mnt=$(mktemp -d)
        unmount_all "$dev"
        sudo mount "$part" "$mnt"
        # shellcheck disable=SC2064
        trap "sync; sudo umount $(printf %q "$mnt") 2>/dev/null || true; rmdir $(printf %q "$mnt") 2>/dev/null || true" EXIT
    fi
    # Nothing on the stick is deleted, older ISOs included; only a file with
    # this ISO's name is replaced, once the new copy (written next to it as
    # .part) is complete and checked: so there must be room for all of it.
    # A .part left by an earlier try is overwritten: its space counts.
    need=$(stat -Lc %s "$iso")
    have=$(df --output=avail -B1 "$mnt" | tail -n1)
    [[ -f $mnt/$name.part ]] && have=$((have + $(stat -c %s "$mnt/$name.part")))
    ((need <= have)) || {
        echo "[ventoy] not enough free space on the stick for $name; nothing was changed:" >&2
        echo "         delete files you no longer need from it (older ISOs, for example)" >&2
        [[ -e $mnt/$name ]] && echo "         (its older copy stays until the new one is checked: room for both is needed)" >&2
        exit 1
    }
    echo "[ventoy] copying $name"
    if ! $as cp "$iso" "$mnt/$name.part" || ! sync || ! $as cmp -s "$iso" "$mnt/$name.part"; then
        $as rm -f "$mnt/$name.part"
        echo "[ventoy] the copy on the stick is damaged; nothing on it was replaced" >&2
        exit 1
    fi
    $as mv "$mnt/$name.part" "$mnt/$name"
    # MeccanicOS-README.pdf next to it (on a stick written directly it is inside
    # the ISO). Optional: if it cannot be built or copied, it is skipped.
    local readme
    if readme=$(nix build .#readme-pdf --impure --no-link --print-out-paths 2>/dev/null) &&
        $as cp "$readme" "$mnt/MeccanicOS-README.pdf.part" 2>/dev/null &&
        $as mv "$mnt/MeccanicOS-README.pdf.part" "$mnt/MeccanicOS-README.pdf" 2>/dev/null; then
        :
    else
        $as rm -f "$mnt/MeccanicOS-README.pdf.part" 2>/dev/null || true
    fi
    sync
    echo "[ventoy] done: boot the stick and pick $name in Ventoy's menu."
    echo "         Vaults and the persistent home go in meccanicos/ on this partition (usb-vault)."
}

# modules/drivers/: every package of EndeavourOS's live ISO mapped, and
# checked on our live ISO (scripts/drivers-check.py; weekly in CI too).
drivers_check() {
    if command -v python3 >/dev/null && command -v curl >/dev/null; then
        python3 scripts/drivers-check.py "$@"
    else
        nix shell nixpkgs#python3 nixpkgs#curl -c python3 scripts/drivers-check.py "$@"
    fi
}

# Tag the head of origin/main as a release and push the tag. Only commits
# already on GitHub's main: the release workflow builds what the tag names.
release() {
    (($# <= 1)) || { echo "usage: $0 release [NAME]" >&2; exit 2; }
    local name=${1:-} head n
    # main and the releases only: "latest" moves, and fetching it would be refused.
    git fetch --quiet origin main 'refs/tags/v*:refs/tags/v*' ||
        { echo "[release] could not fetch from origin" >&2; exit 1; }
    head=$(git rev-parse origin/main)
    if [[ $(git rev-parse HEAD) != "$head" ]]; then
        echo "[release] HEAD is not origin/main ($(git rev-parse --short HEAD) vs $(git rev-parse --short "$head")): push or pull first" >&2
        exit 1
    fi
    [[ -z $(git status --porcelain) ]] || { echo "[release] uncommitted changes: commit them first" >&2; exit 1; }
    if [[ -z $name ]]; then
        name=v$(date -u +%Y-%m-%d)
        n=1
        while git rev-parse -q --verify "refs/tags/$name" >/dev/null; do
            n=$((n + 1))
            name=v$(date -u +%Y-%m-%d).$n
        done
    fi
    [[ $name =~ ^v[a-z0-9._-]+$ ]] || { echo "[release] a release name looks like v2026-10-16 (got $name)" >&2; exit 2; }
    git rev-parse -q --verify "refs/tags/$name" >/dev/null && { echo "[release] $name exists already" >&2; exit 1; }
    local previous
    previous=$(git tag --list 'v*' --merged "$head" | sort -V | tail -n1)
    echo "[release] $name = $(git log -1 --format='%h %s' "$head")"
    [[ -n $previous ]] && echo "[release] since $previous: $(git rev-list --count "$previous..$head") commit(s)"
    git tag -a "$name" -m "$name" "$head"
    git push origin "refs/tags/$name"
    echo "[release] pushed; GitHub builds it: gh run watch \$(gh run list -w Release -L1 --json databaseId -q '.[0].databaseId')"
}

cmd=${1:-}
shift || true
case $cmd in
    update) update "$@" ;;
    iso) iso "$@" ;;
    release) release "$@" ;;
    vm) vm "$@" ;;
    tutorial-video) tutorial_video "$@" ;;
    burn) burn "$@" ;;
    ventoy) ventoy "$@" ;;
    drivers-check) drivers_check "$@" ;;
    *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
